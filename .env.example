# ===========================================
# VERICUM - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# ------ REQUIRED ------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (your deployed domain)
NEXT_PUBLIC_APP_URL=https://vericum.com

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...

# Internal API secret (min 32 chars, used for server-to-server email calls)
INTERNAL_EMAIL_SECRET=generate-a-random-string-at-least-32-characters

# ------ OPTIONAL (graceful fallback if missing) ------

# AI Content Detection APIs
HIVE_API_KEY=
OPTIC_API_KEY=
ILLUMINARTY_API_KEY=

# Toss Payments (Korea only)
TOSS_SECRET_KEY=
